encoding  utf-8
# =====================================================================
#  Therion's station layout, for the sketch conversion tools
# =====================================================================
#
#  Exports where Therion puts every station in plan and in the extended
#  elevation, as XVI files, and the centreline with its splays as SQL.
#  tools/sketch2therion reads them to fit sketches onto the survey
#  (check, plan, extended) and to draw from the splays (roofs,
#  details). Rerun it after adding or changing survey data (a new trip,
#  equates, extend flags):
#
#    therion -l output/therion-layout.log tools/layout.thcfg
#
#  from the top of the repository (see tools/README.md). The paths
#  below are the ones in tools/project.toml. This is a tool's helper,
#  not a survey output.
# ---------------------------------------------------------------------

source ../LongwoodValleySink/LongwoodValleySink.th
source layout.th

select LayoutPlan
select LayoutExtended

export map -projection plan     -fmt xvi -o ../output/layout-plan.xvi
export map -projection extended -fmt xvi -o ../output/layout-extended.xvi
export database -fmt sql -o ../output/layout.sql
