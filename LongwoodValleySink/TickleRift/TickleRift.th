encoding  utf-8
survey TickleRift

input TickleRiftP.th2
input TickleRiftE315.th2

map TickleRiftME315
    TickleRiftSE315_1
endmap
input TickleRiftE000.th2

map TickleRiftME000
    TickleRiftSE000_1
endmap
input TickleRiftE0.th2
#input TickleRiftE90.th2

map TickleRiftMP
  TickleRiftSP1
  break
  TickleRiftSP2
  break
  TickleRiftSP3
  break
  TickleRiftSP4
endmap

map TickleRiftME0
  TickleRiftSE01
endmap

#map TickleRiftME90
#  TickleRiftSE901
#endmap

