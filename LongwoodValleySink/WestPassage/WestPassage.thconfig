encoding utf-8

layout local
  debug off
  # map-header 0 0 off
  # symbol-hide group cave-centreline
endlayout

source "WestPassage.th"

export model -fmt survex -o "WestPassage-th.3d"

export map -proj plan -layout local -o "WestPassage-plan.pdf"

export map -proj extended -layout local -o "WestPassage-ee.pdf"