encoding  utf-8
source TennisBallRift.th


#Surveys to output
#-----------------

#Plan view
export map -proj plan -layout local -o Outputs/TennisBallRiftP.pdf
export map -proj plan -layout local -o Outputs/TennisBallRiftP.xvi

#Profile looking North
#export map -proj elevation -layout local -o Outputs/TennisBallRiftE0.pdf
export map -proj elevation -layout local -o Outputs/TennisBallRiftE0.xvi

#Profile looking East
export map -proj [elevation 90] -layout local -o Outputs/TennisBallRiftE90.pdf
export map -proj [elevation 90] -layout local -o Outputs/TennisBallRiftE90.xvi

#Survex file showing centre line only
export model -fmt survex -o Outputs/TennisBallRiftth.3d

#export model -o Outputs/TennisBallRift.lox
#3d therion model to be viewed in the therion viewer

layout local
debug off
map-header 0 0 ne
#symbol-hide group cave-centreline
endlayout
