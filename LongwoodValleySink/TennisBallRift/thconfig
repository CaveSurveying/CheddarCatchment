encoding  utf-8
source TennisBallRift.th
# Change name to the main therion file


#Surveys to output
#-----------------

export map -proj plan -layout local -o Outputs/TennisBallRiftP.pdf
export map -proj plan -layout local -o Outputs/TennisBallRiftP.xvi
#Produces plan of cave, on a single sheet

export map -proj [elevation 90] -layout local -o Outputs/TennisBallRiftE90.pdf
export map -proj [elevation 90] -layout local -o Outputs/TennisBallRiftE90.xvi

#export map -proj extended -layout local -o Outputs/TennisBallRiftEe.pdf

export model -fmt survex -o Outputs/TennisBallRiftth.3d
