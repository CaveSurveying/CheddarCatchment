encoding  utf-8
# Created with SexyTopo 1.8.3 on 2024-10-27


layout local
  debug off
  # map-header 0 0 off
  # symbol-hide group cave-centreline
endlayout

source "TickleWest.th"

export model -fmt survex -o "TickleWest-th.3d"

export map -proj plan -layout local -o "TickleWest-plan.pdf"

export map -proj extended -layout local -o "TickleWest-ee.pdf"
