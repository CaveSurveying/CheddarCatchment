encoding  utf-8
survey Entrance  -namespace off

input EntranceP.th2
input EntranceE000.th2
input EntranceE0.th2
input EntranceE90.th2

map EntranceME000
    EntranceSE000_1
endmap

map EntranceMP
 EntranceSP1
    break
  EntranceSP2
    break
  EntranceSP3    
endmap

map EntranceME0
  EntranceSE01
endmap

map EntranceME90
  EntranceSE901
endmap

