encoding  utf-8
source Entrance.th

#Surveys to output
#-----------------

export map -proj plan -layout local -o Outputs/EntranceP.pdf
export map -proj plan -layout local -o Outputs/EntranceP.xvi

export map -proj elevation -layout local -o Outputs/EntranceE0.pdf
export map -proj elevation -layout local -o Outputs/EntranceE0.xvi

export map -proj [elevation 90] -layout local -o Outputs/EntranceE90.pdf
export map -proj [elevation 90] -layout local -o Outputs/EntranceE90.xvi

export model -fmt survex -o Outputs/Entranceth.3d
#Survex file showing centre line only

#export model -o Outputs/Entrance.lox
#3d therion model to be viewed in the therion viewer

layout local
copy common
debug off
map-header 0 0 off
symbol-hide group cave-centreline
endlayout

input ../../common_layout.th
