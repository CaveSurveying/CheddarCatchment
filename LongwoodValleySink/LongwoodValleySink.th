encoding  utf-8
survey LongwoodValleySink
#copyright 2014 "GNU GPL"

input BoldStep/BoldStep.th
input Century/Century.th
input CJPitch/CJPitch.th
input CJS/CJS.th
input Connection/Connection.th
input CrossRoads/CrossRoads.th
input CrystalPitch/CrystalPitch.th
input Cyclops/Cyclops.th
input CyclopsEye/CyclopsEye.th
input Entrance/Entrance.th
input FairyChimneys/FairyChimneys.th
input GoSouth/GoSouth.th
#input GoWest/GoWest.th
input IDontCare/IDontCare.th
input NorthRift/NorthRift.th
input RoundTheBend/RoundTheBend.th
input TennisBallRift/TennisBallRift.th
#input TickleRift/TickleRift.th
input TickleWest/TickleWest.th
input TickleCheck/TickleCheck.th
input TritonAven/TritonAven.th
input TritonNorth/TritonNorth.th
input TritonSouth/TritonSouth.th
input Triassic/Triassic.th
input Triassic2/Triassic2.th
input Trident/Trident.th
input TridentCentre/TridentCentre.th
input TridentLeft/TridentLeft.th
input WestPassage/WestPassage.th

#File for toplevel maps
input Maps.th

###################################################################

equate 0@BoldStep 36@TridentLeft
equate 105@CJPitch 105@CrossRoads
equate 121@CJPitch 121@RoundTheBend
equate 106@CJS 106@CrossRoads
equate 1@Connection 94@NorthRift
equate 15@Connection 7@TritonSouth
equate 28@Connection 8@BoldStep
equate 105@CrossRoads 106@NorthRift #NorthRift was originally 105 but the splays look wrong! [AA July '25]
equate 133@CrossRoads 1@Trident
equate 138@CrossRoads 1@CrystalPitch
equate 27@CrystalPitch 1@GoSouth
equate 85@Cyclops 85@CyclopsEye
equate 91@CyclopsEye 98@NorthRift
equate 1@FairyChimneys 20@TritonSouth
equate 6@IDontCare 32@TridentLeft
equate 9 9@Triassic
equate  12@Trident 1@TridentCentre
equate  11@Trident 1@TridentLeft
equate  37@TridentLeft 1@TritonNorth
equate  38@TridentLeft 1@TritonSouth
equate 1@TritonAven 18@TritonNorth
equate 13 14@TennisBallRift 2@TickleCheck 2@TickleWest  # 4 stations connected
#equate 13 30@TickleRift
equate 39@Century 39@TickleWest
equate 53@Century 53@WestPassage
equate 81@Cyclops 81@WestPassage
#equate 47.0@GoWest 47.0@TickleRift
#equate 59.0@GoWest 29@TickleWest
equate 85@NorthRift 85@Cyclops
equate 3@TickleCheck 3@TickleWest
equate 5@TickleCheck 4@TickleWest
equate 6@TickleCheck 5@TickleWest
equate 7@TickleCheck 7@TickleWest
equate 9@TickleCheck 8@TickleWest
equate 10@TickleCheck 9@TickleWest
equate 11@TickleCheck 10@TickleWest
equate 12@TickleCheck 11@TickleWest
equate 13@TickleCheck 12@TickleWest
equate 14@TickleCheck 13@TickleWest
equate 6.0@Triassic 0@Triassic2

centreline
data nosurvey from to
139@RoundTheBend 40@FairyChimneys
endcenterline

###################################################################
#Plan shows all passages
map LongwoodValleySinkMP
  EntranceTriassicMP
  TickleWestMP@TickleWest
  CenturyMP@Century
  WestPassageMP@WestPassage
  CrystalPassageMP
  CrossRoadsMP
  CyclopsMP
  NorthRiftMP
  CJSMP@CJS
  CJPitchMP
  RoundTheBendMP
  GoSouthMP@GoSouth
  TridentMP@Trident
  TridentCentreMP@TridentCentre
  TridentLeftMP@TridentLeft
  IDontCareMP@IDontCare
  BoldStepMP@BoldStep
  TritonNorthMP@TritonNorth
  TritonSouthMP@TritonSouth
  ConnectionMP@Connection
  FairyChimneysMP@FairyChimneys
endmap

###################################################################
map LongwoodValleySinkM315
  EntranceTriassicME315
  TickleWestME315@TickleWest
  CenturyME315@Century
  WestPassageME315@WestPassage
  CrystalPassageME315
  CrossRoadsME315
  CyclopsME315
  NorthRiftME315@NorthRift
  CJSME315@CJS
  CJPitchME315
  RoundTheBendME315
  GoSouthME315@GoSouth
  TridentME315@Trident
  TridentCentreME315@TridentCentre
  TridentLeftME315@TridentLeft
  IDontCareME315@IDontCare
  BoldStepME315@BoldStep
  TritonNorthME315@TritonNorth
  TritonSouthME315@TritonSouth
  ConnectionME315@Connection
  FairyChimneysME315@FairyChimneys
endmap

###################################################################
#Extended elevation: the surveys drawn in extended elevation (the older
#surveys' walls drawn by tools/sketch2therion unfold from their projected
#elevations, for tidying by hand)
map LongwoodValleySinkMEe
  GoSouthMEe@GoSouth
  TridentMEe@Trident
  TridentCentreMEe@TridentCentre
  TridentLeftMEe@TridentLeft
  IDontCareMEe@IDontCare
  BoldStepMEe@BoldStep
  TritonNorthMEe@TritonNorth
  TritonSouthMEe@TritonSouth
  ConnectionMEe@Connection
  FairyChimneysMEe@FairyChimneys
  EntranceMEe
  TennisBallRiftMEe@TennisBallRift
  TriassicMEe@Triassic
  Triassic2MEe@Triassic2
  CenturyMEe@Century
  CJPitchMEe@CJPitch
  CJSMEe@CJS
  CrossRoadsMEe@CrossRoads
  CrystalPitchMEe@CrystalPitch
  CyclopsMEe@Cyclops
  CyclopsEyeMEe@CyclopsEye
  NorthRiftMEe@NorthRift
  RoundTheBendMEe@RoundTheBend
  TickleWestMEe@TickleWest
  WestPassageMEe@WestPassage
endmap

###################################################################
#Profile E90 does NOT show Go West
map LongwoodValleySinkE90M
  EntranceME90@Entrance
  TriassicME90@Triassic
  TennisBallRiftME90@TennisBallRift
 # TickleRiftME90@TickleRift
#  GoWestME90@GoWest
  TickleWestME090@TickleWest
  CenturyME090@Century
endmap

###################################################################
#Joins for Plan
#Scraps
join BoldStepSP1@BoldStep TridentLeftSP1@TridentLeft -smooth on
join CenturySP1@Century TickleWestSP4@TickleWest -smooth on
join CJPitchSP1@CJPitch RoundTheBendSP0@RoundTheBend -smooth on
join ConnectionSP1@Connection NorthRiftSP2@NorthRift -smooth on
join CrossRoadsSP0@CrossRoads CJPitchSP2@CJPitch -smooth on
join CrossRoadsSP0@CrossRoads CJSSP1@CJS -smooth on
join CrossRoadsSP1@CrossRoads CyclopsEyeSP1@CyclopsEye -smooth on
join CrossRoadsSP0@CrossRoads NorthRiftSP2@NorthRift -smooth on
join CrossRoadsSP1@CrossRoads TridentSP1@Trident -smooth on
join CrossRoadsSP2@CrossRoads CrystalPitchSP1@CrystalPitch -smooth on
join CrystalPitchSP1@CrystalPitch GoSouthSP1@GoSouth -smooth on
join CyclopsSP1@Cyclops NorthRiftSP1@NorthRift -smooth on
join CyclopsSP1@Cyclops WestPassage-planS1@WestPassage -smooth on
join CyclopsSP1@Cyclops RoundTheBendSP3@RoundTheBend -smooth on
join CyclopsEyeSP1@CyclopsEye NorthRiftSP2@NorthRift -smooth on
join EntranceSP2@Entrance TriassicSP1@Triassic -smooth on
join EntranceSP3@Entrance TickleWestSP1@TickleWest -smooth on
join EntranceSP3@Entrance TennisBallRiftSP1@TennisBallRift -smooth on
#join TickleRiftSP4@TickleRift GoWestSP1@GoWest -smooth on
join FairyChimneysSP1@FairyChimneys RoundTheBendSP3@RoundTheBend -smooth on
join FairyChimneysSP1@FairyChimneys TritonSouthSP1@TritonSouth -smooth on
join IDontCareSP1@IDontCare TridentLeftSP1@TridentLeft -smooth on
join TriassicSP1@Triassic TriassicSP3@Triassic -smooth on
join TriassicSP3@Triassic Triassic2SP1@Triassic2 -smooth on
join TridentLeftSP1@TridentLeft TritonNorthSP1@TritonNorth -smooth on
join TridentLeftSP1@TridentLeft TritonSouthSP1@TritonSouth -smooth on
join TridentSP1@Trident TridentCentreSP1@TridentCentre -smooth on
join TridentSP1@Trident TridentLeftSP1@TridentLeft -smooth on

#Line Points
join Wall28@BoldStep:C28a Wall28a@Connection:end -smooth on
join Wall28@BoldStep:C28b Wall28b@Connection:0 -smooth on
join  Wall28a@Connection:0 ConnectionLeft@TritonSouth:end -smooth on
join  TritonSouthRight@Connection:end ConnectionRight@TritonSouth:Connect -smooth on
join Wall1@TickleWest:Left Wall2@TickleWest:0 Wall3@TickleWest:0 -smooth on
join Wall1@TickleWest:Right Wall3@TickleWest:end -smooth on
join Wall3@TickleWest:Middle Wall4@TickleWest:end -smooth on


###################################################################
#joins for E000 survey
join CenturySE000_1@Century TickleWestSE000_1@TickleWest -smooth on
join CenturySE000_1@Century WestPassageSE000_1@WestPassage -smooth on
join EntranceSE000_1@Entrance TennisBallRiftSE000_1@TennisBallRift -smooth on
join EntranceSE000_1@Entrance TickleWestSE000_1@TickleWest -smooth on
join EntranceSE000_1@Entrance TriassicSE000_1@Triassic -smooth on
join TriassicSE000_2@Triassic Triassic2SE000_1@Triassic2 -smooth on

###################################################################
#join for E90 survey
#join EntranceSE901@Entrance TriassicSE901@Triassic -smooth on
#join EntranceSE901@Entrance TennisBallRiftSE901@TennisBallRift -smooth on

###################################################################
#### Joins for E315 survey
join BoldStepSE315_1@BoldStep ConnectionSE315_3@Connection -smooth on
join BoldStepSE315_1@BoldStep TridentLeftSE315_3@TridentLeft -smooth on  # TridentLeft 36 is in no scrap: by 35
join CenturySE315_1@Century TickleWestSE315_2@TickleWest -smooth on
join CenturySE315_2@Century WestPassageSE315_1@WestPassage -smooth on
join CJSSE315_1@CJS NorthRiftSE315_1@NorthRift -smooth on
join CJPitchSE315_1@CJPitch NorthRiftSE315_1@NorthRift -smooth on
join CJPitchSE315_3@CJPitch RoundTheBendSE315_1@RoundTheBend -smooth on
join ConnectionSE315_1@Connection NorthRiftSE315_1@NorthRift -smooth on
join ConnectionSE315_3@Connection TritonSouthSE315_1@TritonSouth -smooth on
join CrossRoadsSE315_2@CrossRoads TridentSE315_1@Trident -smooth on
join CrossRoadsSE315_3@CrossRoads CrystalPitchSE315_2@CrystalPitch -smooth on
join CrystalPitchSE315_2@CrystalPitch GoSouthSE315_1@GoSouth -smooth on
join CyclopsSE315_1@Cyclops CyclopsEyeSE315_1@CyclopsEye -smooth on
join CyclopsSE315_1@Cyclops NorthRiftSE315_1@NorthRift -smooth on
join CyclopsSE315_1@Cyclops RoundTheBendSE315_2@RoundTheBend -smooth on
join CyclopsEyeSE315_1@CyclopsEye NorthRiftSE315_1@NorthRift -smooth on
join EntranceSE315_1@Entrance TennisBallRiftSE315_1@TennisBallRift -smooth on
join EntranceSE315_1@Entrance TickleWestSE315_1@TickleWest -smooth on
join EntranceSE315_1@Entrance TriassicSE315_1@Triassic -smooth on
join FairyChimneysSE315_1@FairyChimneys TritonSouthSE315_1@TritonSouth -smooth on
join IDontCareSE315_1@IDontCare TridentLeftSE315_4@TridentLeft -smooth on
join TriassicSE315_1@Triassic Triassic2SE315_1@Triassic2 -smooth on
join TridentLeftSE315_3@TridentLeft TritonNorthSE315_1@TritonNorth -smooth on  # TridentLeft 37 is in no scrap: by 35
join TridentLeftSE315_3@TridentLeft TritonSouthSE315_1@TritonSouth -smooth on  # TridentLeft 38 is in no scrap: by 35  # TritonSouth 1 is in no scrap: by 2
join TridentSE315_2@Trident TridentCentreSE315_1@TridentCentre -smooth on
join TridentSE315_2@Trident TridentLeftSE315_1@TridentLeft -smooth on  # Trident 11 is in no scrap: by 10

#Joins Line points E325
join WallT@Cyclops:0 Wall1@WestPassage:Top
join WallB@Cyclops:end Wall1@WestPassage:Bottom
join WallT@NorthRift:Top WallT_1@CrossRoads:0
join WallB@NorthRift:Bottom WallB_1@CrossRoads:end

###################################################################
#### Joins for extended elevation
join BoldStepSE1@BoldStep ConnectionSE3@Connection -smooth on
join BoldStepSE1@BoldStep TridentLeftSE2@TridentLeft -smooth on
join ConnectionSE1@Connection northrift-ee@NorthRift -smooth on
join ConnectionSE3@Connection TritonSouthSE1@TritonSouth -smooth on
join crossroads-ee@CrossRoads TridentSE1@Trident -smooth on
join crystalpitch-ee@CrystalPitch GoSouthSE1@GoSouth -smooth on
join FairyChimneysSE1@FairyChimneys TritonSouthSE1@TritonSouth -smooth on
join IDontCareSE1@IDontCare TridentLeftSE3@TridentLeft -smooth on
join TridentLeftSE2@TridentLeft TritonNorthSE1@TritonNorth -smooth on
join TridentLeftSE2@TridentLeft TritonSouthSE1@TritonSouth -smooth on  # TritonSouth 1 is in no scrap: by 2
join TridentSE1@Trident TridentCentreSE1@TridentCentre -smooth on
join TridentSE2@Trident TridentLeftSE1@TridentLeft -smooth on

endsurvey

