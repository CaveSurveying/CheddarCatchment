encoding  utf-8
survey Triassic

#Triassic only for Plan and E90

input TriassicP.th2
input TriassicE315.th2

map TriassicME315
    TriassicSE315_1
endmap
input TriassicE000.th2
input TriassicE90.th2

map TriassicME000
    TriassicSE000_2
    TriassicSE000_1
endmap

map TriassicMP
  TriassicSP2
  break
  TriassicSP1
  TriassicSP3
endmap

map TriassicME90
  TriassicSE90_1
endmap

