export map -proj [elevation 90] -layout local -o TriassicE90.pdf

#export map -proj extended -layout local -o TriassicEe.pdf

#export map -proj [elevation 15] -layout local -o TriassicE15.pdf

export model -fmt survex -o Triassicth.3d
