# Created with SexyTopo 1.8.4 on 2025-07-29

encoding utf-8

layout local
  debug off
  # map-header 0 0 off
  # symbol-hide group cave-centreline
endlayout

source "CJS.th"

export model -fmt survex -o "CJS-th.3d"

export map -proj plan -layout local -o "CJS-plan.pdf"

export map -proj extended -layout local -o "CJS-ee.pdf"