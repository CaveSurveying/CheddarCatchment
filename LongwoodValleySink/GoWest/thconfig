encoding  utf-8
source GoWest.th

#Surveys to output
#-----------------

export map -proj plan -layout local -o Outputs/GoWestP.pdf
export map -proj plan -layout local -o Outputs/GoWestP.xvi
#Produces plan of cave, on a single sheet

export map -proj elevation -layout local -o Outputs/GoWestE0.pdf
export map -proj elevation -layout local -o Outputs/GoWestE0.xvi

#export map -proj [elevation 90] -layout local -o Outputs/GoWestE90.pdf
export map -proj [elevation 90] -layout local -o Outputs/GoWestE90.xvi

export model -fmt survex -o Outputs/GoWest.3d
#Survex file showing centre line only

#export model -o Outputs/GoWest.lox
#3d therion model to be viewed in the therion viewer

layout local
copy common
debug off
map-header 0 0 off
#symbol-hide group cave-centreline
endlayout

input ../../common_layout.th
