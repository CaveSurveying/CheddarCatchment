encoding  utf-8
source LongwoodValleySink.th

#Surveys to output
#-----------------

#Produces plan of cave, on a single sheet
export map -proj plan -layout plan -o Outputs/LongwoodValleySinkP.pdf

#Produces elevation looking North (0)
export map -proj [elevation 0] -layout ProjectedNorth -o Outputs/LongwoodValleySinkE000.pdf

#Produces elevation looking East (90)
export map -proj [elevation 90] -layout ProjectedEast -o Outputs/LongwoodValleySinkE90.pdf

export survey-list -o Outputs/survey-list.html

export model -fmt survex -o Outputs/LongwoodValleySinkth.3d
#Survex file showing centre line only

#export model -o Outputs/LongwoodValleySink.lox
#3d therion model to be viewed in the therion viewer Loch

lookup map
  CenturyME000@Century.LongwoodValleySink [90 30 0]
  CenturyMP@Century.LongwoodValleySink [90 30 0]
  EntranceME000@Entrance.LongwoodValleySink [90 90 0]
  EntranceMP@Entrance.LongwoodValleySink [90 90 0]
  TennisBallRiftME000@TennisBallRift.LongwoodValleySink [90 90 0]
  TennisBallRiftMP@TennisBallRift.LongwoodValleySink [90 90 0]
  TickleWestME000@TickleWest.LongwoodValleySink [0 90 0]
  TickleWestMP@TickleWest.LongwoodValleySink [0 90 0]
  TriassicME000@Triassic.LongwoodValleySink [90 0 0]
  TriassicMP@Triassic.LongwoodValleySink [90 0 0]
  Triassic2ME000@Triassic2.LongwoodValleySink [90 0 0]
   Triassic2MP@Triassic2.LongwoodValleySink [90 0 0]
  WestPassageME000@WestPassage.LongwoodValleySink [90 0 90]
  WestPassageMP@WestPassage.LongwoodValleySink [90 0 90]
endlookup

layout plan
copy local
debug off
map-image -2 110 sw Outputs/LongwoodValleySinkE000.pdf
map-header 0 -2 sw
map-header-bg on



map-comment "Location ST 4858 5548 Altitude 207m OD<br>\
Length 365.79m. Vertical Range 91.05m.<br>\
Grade UISv1 6-4-BEF to Slot 2<br>\
Copyright 2014-25 CC BY NC SA<br>\
Data available at cave-registry.org.uk<br>\
Drawn using Therion by Andrew Atkinson. John Cooper<br>\
Survey by Andrew Atkinson, John Cooper, Lee Hawkswell, Alison Moody and Barry Weaver<br>\
<br>\
Heights in metres OD"
grid-coords off
#symbol-hide special north-arrow

scale-bar 10 metres

endlayout

layout ProjectedNorth
copy local
map-comment "Looking North"
map-header 100 10 se
symbol-hide special north-arrow
#symbol-hide special scale-bar

endlayout

layout ProjectedEast

copy local
map-comment "Old Series - Profile Looking East<br>\
Comprising Entrance Rift, Adit, Triassic Tunnel,<br>\
 PSS Rift and Tennis Ball Rift"
map-header 100 70 se
symbol-hide special north-arrow
symbol-hide special scale-bar
endlayout

layout local
copy common
doc-title "Longwood Valley Sink"
grid-size 10 10 10 metres
#symbol-hide special scale-bar

scale 1 250
symbol-hide point remark
symbol-hide group cave-centreline

colour map-fg map
statistics explo off
statistics topo off

code tex-map
  \cavename={\size[20] Longwood Valley Sink}
  \cavelength={}%empty
  \cavedepth={}%empty
  \colorlegendfalse
endcode

endlayout

input ../common_layout.th
