encoding  utf-8
source LongwoodValleySink.th
# Change name to the main therion file

#Surveys to output
#-----------------

export map -proj [elevation 90] -layout local -o LongwoodValleySinkE90.pdf
#Produces elevation looking East (90)

export map -proj plan -layout local -o LongwoodValleySinkP.pdf
#Produces plan of cave, on a single sheet

#export map -proj extended -layout local -o LongwoodValleySinkEe.pdf

export model -fmt survex -o LongwoodValleySinkth.3d
#Survex file showing centre line only

export model -o LongwoodValleySink.lox
#3d therion model to be viewed in the therion viewer

#export map -proj plan -o LongwoodValleySink_Walls.3d
#Survex file showing walls only

layout local
debug off
map-header 0 0 ne
north grid
grid bottom
grid-size 5 5 5 m
#symbol-hide group cave-centreline
endlayout
