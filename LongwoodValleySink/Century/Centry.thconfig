# Created with SexyTopo 1.8.3 on 2024-11-02

encoding utf-8

layout local
  debug off
  # map-header 0 0 off
  # symbol-hide group cave-centreline
endlayout

source "Century.th"

export model -fmt survex -o "Centry-th.3d"

export map -proj plan -layout local -o "Centry-plan.pdf"

export map -proj extended -layout local -o "Centry-ee.pdf"